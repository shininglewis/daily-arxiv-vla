# DeepSeek 官方 API（推荐）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled

# 兼容旧变量名：也可把 DeepSeek Key 填到 MODELSCOPE_ACCESS_TOKEN
MODELSCOPE_ACCESS_TOKEN=
MODELSCOPE_BASE_URL=https://api.deepseek.com
MODELSCOPE_MODEL=deepseek-v4-flash
MODELSCOPE_MODELS=deepseek-v4-flash

# arXiv 爬虫配置
ARXIV_QUERY_KEYWORD=all:"VLA" OR all:"Vision-Language-Action" OR all:"World Action Model" OR all:"World-Action Model" OR all:"action world model"
ARXIV_INIT_RESULTS=500
ARXIV_DAILY_RESULTS=20
ARXIV_MAX_RETRIES=3

# HTTP 请求配置
HTTP_MAX_RETRIES=3
HTTP_TIMEOUT=30
HTML_MAX_CHARS=180000

# API 调用配置
API_MAX_RETRIES=3

# 性能优化配置
BATCH_WRITE_SIZE=5
